# ─── LÜMEN Requirements Intelligence — пример конфигурации ───────────────────
# Скопируйте в .env (cp .env.example .env) и заполните. Файл .env не коммитится.

# Провайдер LLM: auto | anthropic | gemini | openrouter | groq | openai | claude-cli | offline
#   auto — выбрать по найденному ключу: Anthropic → Gemini → OpenAI-совместимый → offline (только правила)
LLM_PROVIDER=auto
# Модель (пусто = рекомендуемая для провайдера: claude-opus-5-5 / gemini-flash-latest / gpt-5.5-mini)
LLM_MODEL=
# Резервные модели через запятую, если у основной кончилась квота. Для основного провайдера — LLM_FALLBACK_MODELS,
# для конкретного — LLM_FALLBACK_MODELS_GEMINI / _GROQ / _OPENROUTER (по умолчанию заданы разумные списки)
LLM_FALLBACK_MODELS=

# Claude (рекомендуется для финального прогона): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Gemini (бесплатный тариф): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (бесплатные модели :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq (бесплатный тариф, очень быстро): https://console.groq.com/keys
GROQ_API_KEY=
# 1 — если основной провайдер недоступен, автоматически использовать другие провайдеры с заданными ключами
LLM_PROVIDER_CHAIN=1
# OpenAI-совместимый API (OpenAI, DeepSeek, локальные модели…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Параметры анализа
LLM_TEMPERATURE=
LLM_MAX_RETRIES=3
LLM_TIMEOUT=600
LUMEN_BATCH_SIZE=12
# Один и тот же файл в течение N часов отдаёт тот же отчёт (сайт и бот совпадают). 0 — выключить
LUMEN_CACHE_HOURS=24
LUMEN_CONCURRENCY=4
# Пауза перед повтором шага LLM, упавшего на лимитах бесплатного тарифа (сек.)
LUMEN_RETRY_PAUSE=8
LUMEN_VERIFY=1

# Сервер
APP_ENV=development
LOG_LEVEL=INFO
LUMEN_DATA_DIR=data
# Безопасность (подробно — SECURITY.md)
# Пароль администратора: вход в панели (Настройки → Вход администратора) — удаление отчётов, работа без лимитов.
# Для скриптов/CI тот же пароль можно передавать заголовком X-API-Token.
LUMEN_ADMIN_PASSWORD=
# 1 — посетители могут проверять документы без входа (с лимитами); 0 — проверка только для администратора
LUMEN_PUBLIC_AUDITS=1
# Устаревшее имя пароля (используется, если LUMEN_ADMIN_PASSWORD не задан)
LUMEN_API_TOKEN=
# Ключ шифрования отчётов AES-256-GCM. Сгенерировать:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
LUMEN_ENCRYPTION_KEY=
# 1 — закрыть и просмотр отчётов (только с токеном)
LUMEN_PRIVATE=0
# 1 — демо-прогон доступен без токена
LUMEN_PUBLIC_DEMO=1
# Лимиты: анализов в час и запросов в минуту на IP; анализов и сообщений в час на чат бота
LUMEN_RATE_AUDITS=20
LUMEN_RATE_REQUESTS=240
LUMEN_BOT_AUDITS=10
LUMEN_BOT_MESSAGES=60
# CORS: пусто в production (панель на том же домене); * — для разработки
LUMEN_CORS=
# Публичный адрес dashboard (для ссылок из Telegram-бота), например https://lumen.up.railway.app
LUMEN_PUBLIC_URL=

# Supabase (необязательно — постоянная история прогонов). Таблица: supabase/migrations/001_audits.sql
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Telegram-бот (необязательно): токен от @BotFather. Бот стартует вместе с API (LUMEN_BOT_IN_API=1)
TELEGRAM_BOT_TOKEN=
LUMEN_BOT_IN_API=1

# Ключ подписи сессий администратора и ключей редактирования (любая длинная случайная строка).
# Если не задан — выводится из LUMEN_ENCRYPTION_KEY, иначе случайный (вход сбрасывается при перезапуске).
LUMEN_SESSION_SECRET=
# Сколько доверенных прокси стоит перед сервером (Railway — 1). Нужен для честного определения IP в лимитах.
LUMEN_TRUSTED_PROXY_HOPS=1
