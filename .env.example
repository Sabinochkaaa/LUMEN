# ─── LÜMEN Requirements Intelligence — пример конфигурации ───────────────────
# Скопируйте в .env (cp .env.example .env) и заполните. Файл .env не коммитится.

# Провайдер LLM: auto | anthropic | gemini | openai | claude-cli | offline
#   auto — выбрать по найденному ключу: Anthropic → Gemini → OpenAI-совместимый → offline (только правила)
LLM_PROVIDER=auto
# Модель (пусто = рекомендуемая для провайдера: claude-opus-5-5 / gemini-flash-latest / gpt-5.5-mini)
LLM_MODEL=

# Claude (рекомендуется для финального прогона): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Gemini (бесплатный тариф): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI-совместимый API (OpenAI, OpenRouter, DeepSeek, Groq…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Параметры анализа
LLM_TEMPERATURE=
LLM_MAX_RETRIES=3
LLM_TIMEOUT=600
LUMEN_BATCH_SIZE=8
LUMEN_CONCURRENCY=4
LUMEN_VERIFY=1

# Сервер
APP_ENV=development
LOG_LEVEL=INFO
LUMEN_DATA_DIR=data
# Если задан — запуск аудитов через API требует заголовок X-API-Token
LUMEN_API_TOKEN=
LUMEN_CORS=*
# Публичный адрес dashboard (для ссылок из Telegram-бота), например https://lumen.up.railway.app
LUMEN_PUBLIC_URL=

# Supabase (необязательно — постоянная история прогонов). Таблица: supabase/migrations/001_audits.sql
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Telegram-бот (необязательно): токен от @BotFather. Бот стартует вместе с API (LUMEN_BOT_IN_API=1)
TELEGRAM_BOT_TOKEN=
LUMEN_BOT_IN_API=1
